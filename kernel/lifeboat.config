# Applied on top of Arch's generic x86_64 config (kernel/arch.config).
# General purpose: every driver Arch ships stays enabled, mostly as modules.
# Only the pieces needed before the real root is mounted are built in.

CONFIG_LOCALVERSION="-lifeboat"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_IKHEADERS is not set
CONFIG_KERNEL_ZSTD=y

# started by systemd-boot, which hands over the cmdline and both initrds
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y

# root = squashfs (ram) + overlay, changes on xfs over zram/dm
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CLONE=y
CONFIG_XFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y

# finding the stick before the root is up
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

# reading the system image off the stick's boot partition
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# firmware and the rest of the drivers load from the mounted root
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# qemu testing
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_HW_RANDOM_VIRTIO=y
