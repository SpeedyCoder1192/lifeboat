#!/bin/sh
# tty1: the wayland session. labwc with the home screen in a terminal.
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc:wlroots
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export XCURSOR_THEME=Adwaita

# on the way down, don't come back up
[ -e /run/lifeboat/leaving ] && exec sleep 3600

# let the boot animation finish before the desktop takes the screen
if pgrep -x lifeboat-splash >/dev/null; then
    echo "end=1" > /run/lifeboat/splash
    for _ in $(seq 30); do
        pgrep -x lifeboat-splash >/dev/null || break
        sleep 0.1
    done
fi

cd "$HOME"
started=$(date +%s)
dbus-run-session -- labwc >/tmp/session.log 2>&1
if [ $(($(date +%s) - started)) -lt 5 ]; then
    # no usable gpu driver: draw on the cpu
    WLR_RENDERER=pixman dbus-run-session -- labwc >>/tmp/session.log 2>&1
fi
if [ ! -e /run/lifeboat/leaving ] && [ $(($(date +%s) - started)) -lt 10 ]; then
    echo
    echo "the desktop didn't start. /tmp/session.log says why."
    echo "you're in a shell now. exit tries again."
    exec bash -l
fi
